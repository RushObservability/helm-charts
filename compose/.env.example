# Optional overrides for docker-compose.yml. Compose already has working local
# defaults, so copy this to .env beside the compose file and keep only the
# settings you actually want to change.

COMPOSE_PROJECT_NAME=rush-local

# Published localhost ports
RUSH_FRONTEND_PORT=5173
RUSH_API_PORT=8080
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
DEMO_GATEWAY_PORT=3000
SRE_AGENT_PORT=8081

# Local login. This only seeds a new ClickHouse volume.
INITIAL_ADMIN_PASSWORD=rush-admin123

# Local ClickHouse identities
CLICKHOUSE_USER=rushdev
CLICKHOUSE_PASSWORD=rush-local-clickhouse-password
CLICKHOUSE_READ_PASSWORD=rush-local-read-password

# Optional licensed build token
RUSH_LICENSE_KEY=

# SRE agent profile
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
QUERY_API_URL=http://query-api:8080
SRE_AGENT_INTERNAL_TOKEN=rush-local-sre-agent-internal-token
SRE_AGENT_MAX_CONCURRENT_INVESTIGATIONS=4
SRE_AGENT_MAX_QUEUED_INVESTIGATIONS=16
SRE_AGENT_MAX_TOOL_STEPS=40
SRE_AGENT_MAX_LLM_CALLS=55
SRE_AGENT_RUNTIME_METRICS_INTERVAL_SECS=15

# Demo traffic profile
DEMO_REQUESTS_PER_SECOND=5
DEMO_DURATION_SECONDS=3600

# UI
DEFAULT_THEME=light
