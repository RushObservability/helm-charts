            <password from_env="CLICKHOUSE_READ_PASSWORD" />
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <access_management>0</access_management>
        </rushquery>
    </users>
</clickhouse>
