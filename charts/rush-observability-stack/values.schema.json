{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["rush", "global", "collectors", "metricsAgent", "postgresCollector", "mysqlCollector"],
  "additionalProperties": false,
  "properties": {
    "rush": {
      "type": "object",
      "required": ["queryApi"],
      "additionalProperties": true,
      "properties": {
        "sreAgent": { "not": {} },
        "infrastructure": { "not": {} },
        "argocd": { "not": {} },
        "fluxcd": { "not": {} },
        "kubernetes": { "not": {} },
        "cloudwatch": { "not": {} },
        "rushConfig": { "not": {} },
        "ingress": { "not": {} },
        "queryApi": {
          "type": "object",
          "required": ["config", "integrations", "ingress"],
          "additionalProperties": true,
          "properties": {
            "environment": { "not": {} },
            "baseUrl": { "not": {} },
            "existingSecret": { "not": {} },
            "kubernetesAccess": { "not": {} },
            "ingress": {
              "type": "object",
              "required": ["enabled", "className", "frontend"],
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "className": { "type": "string" },
                "frontend": { "type": "object", "required": ["host", "tls"], "additionalProperties": true }
              }
            },
            "config": {
              "type": "object",
              "required": ["runtime", "statsEngine", "promql", "secrets", "retention"],
              "additionalProperties": true,
              "properties": {
                "runtime": {
                  "type": "object",
                  "required": ["environment", "baseUrl"],
                  "additionalProperties": true,
                  "properties": {
                    "environment": { "type": "string", "enum": ["production", "development", "local", "test"] },
                    "baseUrl": { "type": "string" }
                  }
                },
                "promql": {
                  "type": "object",
                  "required": ["lookbackSecs"],
                  "additionalProperties": false,
                  "properties": {
                    "lookbackSecs": { "type": "integer", "minimum": 1 }
                  }
                },
                "statsEngine": {
                  "type": "object",
                  "required": ["intervalSecs"],
                  "additionalProperties": false,
                  "properties": {
                    "intervalSecs": { "type": "integer", "minimum": 1 }
                  }
                },
                "secrets": {
                  "type": "object",
                  "required": ["existingSecret"],
                  "additionalProperties": true,
                  "properties": {
                    "existingSecret": { "type": "string" }
                  }
                },
                "retention": {
                  "type": "object",
                  "required": ["defaults", "metrics", "traces", "enforcer"],
                  "additionalProperties": true
                },
                "integrations": { "not": {} }
              }
            },
            "integrations": {
              "type": "object",
              "required": ["sreAgent", "kubernetes", "argocd", "fluxcd"],
              "additionalProperties": true,
              "properties": {
                "sreAgent": { "type": "object", "required": ["enabled"], "additionalProperties": true },
                "kubernetes": { "type": "object", "required": ["enabled"], "additionalProperties": true },
                "argocd": { "type": "object", "required": ["enabled", "namespace"], "additionalProperties": true },
                "fluxcd": { "type": "object", "required": ["enabled", "namespace"], "additionalProperties": true }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "required": ["image", "rush"],
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "required": ["registry"],
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?(/[A-Za-z0-9][A-Za-z0-9._-]*)*/?$"
            }
          }
        },
        "rush": {
          "type": "object",
          "required": ["stack", "queryApi", "ingestApiKeySecret"],
          "additionalProperties": true,
          "properties": {
            "stack": {
              "type": "object",
              "required": ["enabled"],
              "properties": { "enabled": { "const": true } },
              "additionalProperties": true
            },
            "queryApiIngressComponents": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "queryApi": {
              "type": "object",
              "required": ["serviceName", "port"],
              "properties": {
                "serviceName": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              },
              "additionalProperties": true
            },
            "ingestApiKeySecret": {
              "type": "object",
              "required": ["autoGenerate", "name", "key", "value"],
              "properties": {
                "autoGenerate": { "type": "boolean" },
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 },
                "value": { "type": "string", "pattern": "^$|^.{32,}$" }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "collectors": {
      "type": "object",
      "required": ["mode", "allowAnonymousIngest", "otel", "vector"],
      "additionalProperties": true,
      "properties": {
        "mode": { "type": "string", "enum": ["none", "otel", "vector", "hybrid"] },
        "allowAnonymousIngest": { "type": "boolean" },
        "otel": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "kind": { "type": "string", "enum": ["deployment", "daemonset"] },
            "replicas": { "type": "integer", "minimum": 1 }
          }
        },
        "vector": {
          "type": "object",
          "additionalProperties": true,
          "properties": { "mode": { "type": "string", "enum": ["logs", "full-otel"] } }
        }
      }
    },
    "metricsAgent": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    },
    "postgresCollector": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    },
    "mysqlCollector": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    }
  }
}
