{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Rush Observability Helm values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "partialImage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
      }
    },
    "intOrPercent": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^(100|[0-9]{1,2})%$" }
      ]
    },
    "rollout": {
      "type": "object",
      "required": ["strategy", "minReadySeconds", "progressDeadlineSeconds", "revisionHistoryLimit"],
      "additionalProperties": true,
      "properties": {
        "strategy": { "type": "string", "enum": ["RollingUpdate", "Recreate"] },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercent" },
        "maxSurge": { "$ref": "#/definitions/intOrPercent" },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "RollingUpdate" } } },
          "then": { "required": ["maxUnavailable", "maxSurge"] }
        }
      ]
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "type", "value"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "type": { "type": "string", "enum": ["minAvailable", "maxUnavailable"] },
        "value": { "$ref": "#/definitions/intOrPercent" }
      }
    },
    "daemonRollout": {
      "type": "object",
      "required": ["strategy", "minReadySeconds", "revisionHistoryLimit"],
      "additionalProperties": true,
      "properties": {
        "strategy": { "type": "string", "enum": ["RollingUpdate", "OnDelete"] },
        "maxUnavailable": { "$ref": "#/definitions/intOrPercent" },
        "maxSurge": { "$ref": "#/definitions/intOrPercent" },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "strategy": { "const": "RollingUpdate" } } },
          "then": { "required": ["maxUnavailable", "maxSurge"] }
        }
      ]
    },
    "probe": {
      "type": "object",
      "required": ["enabled", "path", "initialDelaySeconds", "periodSeconds", "timeoutSeconds", "failureThreshold", "successThreshold"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "scheme": { "type": "string", "enum": ["HTTP", "HTTPS"] },
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "probes": {
      "type": "object",
      "required": ["startup", "readiness", "liveness"],
      "additionalProperties": true,
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "extraIngress", "extraEgress"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowSameNamespaceIngress": { "type": "boolean" },
        "allowExternalHttpsEgress": { "type": "boolean" },
        "allowExternalClickHouseEgress": { "type": "boolean" },
        "allowSmtpEgress": { "type": "boolean" },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "extraEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "ingressRoute": {
      "type": "object",
      "required": ["enabled", "host", "path", "pathType", "tls"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    },
    "podOptions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "priorityClassName": { "type": "string" },
        "runtimeClassName": { "type": "string" },
        "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object", "required": ["name", "mountPath"] } },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" }
      }
    }
  },
  "required": ["queryApi", "frontend", "clickhouse", "kubernetesAccessGateway"],
  "properties": {
    "imageSecurity": {
      "type": "object",
      "properties": { "requireDigests": { "type": "boolean" } },
      "additionalProperties": true
    },
    "statsEngine": { "type": "object", "additionalProperties": true },
    "rushConfig": { "not": {} },
    "global": {
      "type": "object",
      "required": ["image"],
      "additionalProperties": true,
      "properties": {
        "image": {
          "type": "object",
          "required": ["registry"],
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string",
              "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?(/[A-Za-z0-9][A-Za-z0-9._-]*)*/?$"
            }
          }
        },
        "rush": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "queryApiIngressComponents": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "ingestApiKeySecret": {
              "type": "object",
              "required": ["autoGenerate", "name", "key", "value"],
              "additionalProperties": true,
              "properties": {
                "autoGenerate": { "type": "boolean" },
                "name": { "type": "string" },
                "key": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            }
          }
        },
        "scheduling": { "$ref": "#/definitions/scheduling" },
        "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "priorityClassName": { "type": "string" },
        "runtimeClassName": { "type": "string" },
        "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
        "extraVolumes": { "type": "array", "items": { "type": "object", "required": ["name"] } },
        "extraVolumeMounts": { "type": "array", "items": { "type": "object", "required": ["name", "mountPath"] } },
        "serviceAccount": {
          "type": "object",
          "properties": {
            "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "trustedProxyCidrs", "frontend", "api"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "trustedProxyCidrs": { "type": "array", "items": { "type": "string" } },
        "frontend": { "$ref": "#/definitions/ingressRoute" },
        "api": { "$ref": "#/definitions/ingressRoute" }
      }
    },
    "queryApi": {
      "type": "object",
      "required": ["config", "integrations", "image", "replicas", "port", "rollout", "podDisruptionBudget", "probes", "drainWorker", "auditSpoolPersistence"],
      "additionalProperties": true,
      "properties": {
        "config": {
          "type": "object",
          "required": ["runtime", "authentication", "promql", "secrets", "audit", "retention", "ingest"],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "type": "object",
              "required": ["environment", "baseUrl", "trustedProxyCidrs", "extraEnv"],
              "additionalProperties": false,
              "properties": {
                "environment": { "type": "string", "enum": ["production", "development", "local", "test"] },
                "baseUrl": { "type": "string" },
                "trustedProxyCidrs": { "type": "array", "items": { "type": "string" } },
                "extraEnv": {
                  "type": "object",
                  "additionalProperties": { "type": ["string", "number", "boolean"] }
                }
              }
            },
            "authentication": {
              "type": "object",
              "required": ["allowAnonymousDefault", "ssoReplayStore", "loginRateLimit", "session"],
              "additionalProperties": false,
              "properties": {
                "allowAnonymousDefault": { "type": "boolean" },
                "ssoReplayStore": { "type": "string", "enum": ["auto", "local", "keeper"] },
                "loginRateLimit": {
                  "type": "object",
                  "required": ["accountPerMinute", "ipPerMinute"],
                  "additionalProperties": false,
                  "properties": {
                    "accountPerMinute": { "type": "integer", "minimum": 1 },
                    "ipPerMinute": { "type": "integer", "minimum": 1 }
                  }
                },
                "session": {
                  "type": "object",
                  "required": ["idleTimeoutSeconds", "absoluteTimeoutSeconds", "renewalIntervalSeconds"],
                  "additionalProperties": false,
                  "properties": {
                    "idleTimeoutSeconds": { "type": "integer", "minimum": 1 },
                    "absoluteTimeoutSeconds": { "type": "integer", "minimum": 1 },
                    "renewalIntervalSeconds": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            },
            "promql": {
              "type": "object",
              "required": ["lookbackSecs"],
              "additionalProperties": false,
              "properties": {
                "lookbackSecs": { "type": "integer", "minimum": 1 }
              }
            },
            "secrets": {
              "type": "object",
              "required": ["existingSecret", "adminPassword", "apiKeyHmacSecret", "auditHmacSecret", "sessionHmacSecret", "ssoTransactionSecret", "configEncryptionKey"],
              "additionalProperties": false,
              "properties": {
                "existingSecret": { "type": "string" },
                "adminPassword": { "type": "string" },
                "apiKeyHmacSecret": { "type": "string", "pattern": "^$|^.{32,}$" },
                "auditHmacSecret": { "type": "string" },
                "sessionHmacSecret": { "type": "string" },
                "ssoTransactionSecret": { "type": "string" },
                "configEncryptionKey": { "type": "string" }
              }
            },
            "audit": {
              "type": "object",
              "required": ["keyId", "previousKeysJson", "spoolMaxBytes"],
              "additionalProperties": false,
              "properties": {
                "keyId": { "type": "string", "minLength": 1 },
                "previousKeysJson": { "type": "string" },
                "spoolMaxBytes": { "type": "integer", "minimum": 1 }
              }
            },
            "retention": {
              "type": "object",
              "required": ["defaults", "metrics", "traces", "enforcer"],
              "additionalProperties": false,
              "properties": {
                "defaults": {
                  "type": "object",
                  "required": ["metricsDays", "tracesDays", "logsDays"],
                  "additionalProperties": false,
                  "properties": {
                    "metricsDays": { "type": "integer", "minimum": 1 },
                    "tracesDays": { "type": "integer", "minimum": 1 },
                    "logsDays": { "type": "integer", "minimum": 1 }
                  }
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["retainDays"],
                    "additionalProperties": false,
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "nameRegex": { "type": "string", "minLength": 1 },
                      "labels": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": { "type": "string" }
                      },
                      "retainDays": { "type": "integer", "minimum": 1 }
                    },
                    "anyOf": [
                      { "required": ["name"] },
                      { "required": ["nameRegex"] },
                      { "required": ["labels"] }
                    ]
                  }
                },
                "traces": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["retainDays"],
                    "additionalProperties": false,
                    "properties": {
                      "serviceName": { "type": "string", "minLength": 1 },
                      "attribute": {
                        "type": "object",
                        "required": ["key", "value"],
                        "additionalProperties": false,
                        "properties": {
                          "key": { "type": "string", "minLength": 1 },
                          "value": { "type": "string" }
                        }
                      },
                      "retainDays": { "type": "integer", "minimum": 1 }
                    },
                    "anyOf": [
                      { "required": ["serviceName"] },
                      { "required": ["attribute"] }
                    ]
                  }
                },
                "enforcer": {
                  "type": "object",
                  "required": ["enabled", "intervalSeconds", "dryRun"],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "intervalSeconds": { "type": "integer", "minimum": 1 },
                    "dryRun": { "type": "boolean" }
                  }
                }
              }
            },
            "ingest": {
              "type": "object",
              "required": ["limits", "buffer"],
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "type": "object",
                  "required": ["maxCompressedBytes", "maxDecompressedBytes", "maxEntities", "maxSeries", "maxSamples", "maxMetadata", "maxLabelsPerSeries", "maxLabelNameBytes", "maxLabelValueBytes", "decodeConcurrency"],
                  "additionalProperties": false,
                  "properties": {
                    "maxCompressedBytes": { "type": "integer", "minimum": 1 },
                    "maxDecompressedBytes": { "type": "integer", "minimum": 1 },
                    "maxEntities": { "type": "integer", "minimum": 1 },
                    "maxSeries": { "type": "integer", "minimum": 1 },
                    "maxSamples": { "type": "integer", "minimum": 1 },
                    "maxMetadata": { "type": "integer", "minimum": 1 },
                    "maxLabelsPerSeries": { "type": "integer", "minimum": 1 },
                    "maxLabelNameBytes": { "type": "integer", "minimum": 1 },
                    "maxLabelValueBytes": { "type": "integer", "minimum": 1 },
                    "decodeConcurrency": { "type": "integer", "minimum": 1 }
                  }
                },
                "buffer": {
                  "type": "object",
                  "required": ["backend", "maxBytes", "objectStore"],
                  "additionalProperties": false,
                  "properties": {
                    "backend": { "type": "string", "enum": ["disk", "object_store"] },
                    "maxBytes": { "type": "integer", "minimum": 1 },
                    "objectStore": {
                      "type": "object",
                      "required": ["endpoint", "bucket", "prefix", "region", "credentialsSecret"],
                      "additionalProperties": false,
                      "properties": {
                        "endpoint": { "type": "string" },
                        "bucket": { "type": "string" },
                        "prefix": { "type": "string", "minLength": 1 },
                        "region": { "type": "string", "minLength": 1 },
                        "credentialsSecret": {
                          "type": "object",
                          "required": ["name", "accessKeyKey", "secretKeyKey"],
                          "additionalProperties": false,
                          "properties": {
                            "name": { "type": "string" },
                            "accessKeyKey": { "type": "string", "minLength": 1 },
                            "secretKeyKey": { "type": "string", "minLength": 1 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "integrations": {
          "type": "object",
          "required": ["infrastructure", "argocd", "fluxcd", "kubernetes", "cloudwatch", "kubernetesAccess", "sreAgent"],
          "additionalProperties": false,
          "properties": {
            "infrastructure": {
              "type": "object",
              "required": ["tenantNamespaces"],
              "additionalProperties": false,
              "properties": {
                "tenantNamespaces": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            },
            "argocd": {
              "type": "object",
              "required": ["enabled", "namespace"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string", "minLength": 1 }
              }
            },
            "fluxcd": {
              "type": "object",
              "required": ["enabled", "namespace"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespace": { "type": "string", "minLength": 1 }
              }
            },
            "kubernetes": {
              "type": "object",
              "required": ["enabled", "namespaces", "clusterWide"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "namespaces": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "clusterWide": { "type": "boolean" }
              }
            },
            "cloudwatch": {
              "type": "object",
              "required": ["enabled"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" }
              }
            },
            "kubernetesAccess": {
              "type": "object",
              "required": ["enabled", "internalToken", "maxResultBytes", "maxSessionBytes", "retentionDays", "retainRawIp", "collectPrivateIp", "credentialTtlSeconds"],
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "internalToken": { "type": "string", "pattern": "^$|^.{32,}$" },
                "maxResultBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
                "maxSessionBytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
                "retentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
                "retainRawIp": { "type": "boolean" },
                "collectPrivateIp": { "type": "boolean" },
                "credentialTtlSeconds": { "type": "integer", "minimum": 300, "maximum": 43200 }
              }
            },
            "sreAgent": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "internalAuthToken": { "type": "string" },
                "service": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                  }
                }
              }
            }
          }
        },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "inheritGlobalScheduling": { "type": "boolean" },
        "scheduling": { "$ref": "#/definitions/scheduling" },
        "rollout": { "$ref": "#/definitions/rollout" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "probes": { "$ref": "#/definitions/probes" },
        "networkPolicy": { "$ref": "#/definitions/networkPolicy" },
        "drainWorker": {
          "type": "object",
          "required": ["enabled", "rollout", "podDisruptionBudget", "terminationGracePeriodSeconds"],
          "additionalProperties": true,
          "allOf": [{ "$ref": "#/definitions/podOptions" }],
          "properties": {
            "enabled": { "type": "boolean" },
            "inheritGlobalScheduling": { "type": "boolean" },
            "scheduling": { "$ref": "#/definitions/scheduling" },
            "rollout": { "$ref": "#/definitions/rollout" },
            "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        "auditSpoolPersistence": {
          "type": "object",
          "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "existingClaim": { "type": "string" },
            "storageClass": { "type": "string" },
            "accessModes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "size": { "type": "string", "minLength": 1 }
          }
        },
        "adminPassword": { "not": {} },
        "apiKeyHmacSecret": { "not": {} },
        "auditHmacSecret": { "not": {} },
        "sessionHmacSecret": { "not": {} },
        "ssoTransactionSecret": { "not": {} },
        "configEncryptionKey": { "not": {} },
        "existingSecret": { "not": {} },
        "environment": { "not": {} },
        "baseUrl": { "not": {} },
        "trustedProxyCidrs": { "not": {} },
        "ssoReplayStore": { "not": {} },
        "loginRateLimit": { "not": {} },
        "ingestLimits": { "not": {} },
        "session": { "not": {} },
        "allowAnonymousDefault": { "not": {} },
        "env": { "not": {} },
        "buffer": { "not": {} },
        "audit": { "not": {} },
        "kubernetesAccess": { "not": {} }
      },
      "allOf": [
        { "$ref": "#/definitions/podOptions" },
        {
          "if": { "properties": { "replicas": { "minimum": 2 } }, "required": ["replicas"] },
          "then": {
            "properties": {
              "config": {
                "properties": {
                  "ingest": {
                    "properties": {
                      "buffer": {
                        "properties": {
                          "backend": { "const": "object_store" },
                          "objectStore": {
                            "properties": {
                              "bucket": { "minLength": 1 },
                              "credentialsSecret": { "properties": { "name": { "minLength": 1 } } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "drainWorker": {
                "properties": { "enabled": { "const": true } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "config": {
                "properties": {
                  "ingest": {
                    "properties": {
                      "buffer": { "properties": { "backend": { "const": "object_store" } } }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "config": {
                "properties": {
                  "ingest": {
                    "properties": {
                      "buffer": {
                        "properties": {
                          "objectStore": {
                            "properties": {
                              "bucket": { "minLength": 1 },
                              "credentialsSecret": { "properties": { "name": { "minLength": 1 } } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "drainWorker": { "properties": { "enabled": { "const": true } } } } },
          "then": {
            "properties": {
              "config": {
                "properties": {
                  "ingest": {
                    "properties": {
                      "buffer": { "properties": { "backend": { "const": "object_store" } } }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "frontend": {
      "type": "object",
      "required": ["image", "replicas", "containerPort", "rollout", "podDisruptionBudget", "probes"],
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/definitions/podOptions" }],
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "rollout": { "$ref": "#/definitions/rollout" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "probes": { "$ref": "#/definitions/probes" },
        "networkPolicy": { "$ref": "#/definitions/networkPolicy" }
      }
    },

    "anomalyEngine": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/definitions/podOptions" }],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/partialImage" },
        "rollout": { "$ref": "#/definitions/rollout" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "networkPolicy": { "$ref": "#/definitions/networkPolicy" }
      }
    },
    "kubernetesAccessGateway": {
      "type": "object",
      "required": ["enabled", "image", "replicas", "port", "queryApiUrl", "gatewayId", "clusterId", "tenantIds", "failurePolicy", "trustedProxyCidrs", "upstream", "tls", "service", "serviceAccount", "rbac", "networkPolicy", "podDisruptionBudget"],
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/definitions/podOptions" }],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "replicas": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "queryApiUrl": { "type": "string", "pattern": "^$|^https?://" },
        "gatewayId": { "type": "string", "maxLength": 253 },
        "clusterId": { "type": "string", "maxLength": 253 },
        "tenantIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "failurePolicy": { "type": "string", "enum": ["fail_open", "fail_closed"] },
        "trustedProxyCidrs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 64 }
        },
        "inheritGlobalScheduling": { "type": "boolean" },
        "scheduling": { "$ref": "#/definitions/scheduling" },
        "rbac": {
          "type": "object",
          "required": ["createImpersonationRole", "manageRoles"],
          "additionalProperties": false,
          "properties": {
            "createImpersonationRole": { "type": "boolean" },
            "manageRoles": { "type": "boolean" }
          }
        },
        "upstream": {
          "type": "object",
          "required": ["url", "caFile", "insecure", "egressCidrs"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "pattern": "^https?://" },
            "caFile": { "type": "string" },
            "insecure": { "type": "boolean" },
            "egressCidrs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 3, "maxLength": 64 }
            }
          }
        },
        "tls": {
          "type": "object",
          "required": ["existingSecret"],
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" }
          }
        },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "nodePort": {
              "oneOf": [
                { "type": "null" },
                { "type": "integer", "minimum": 30000, "maximum": 32767 }
              ]
            }
          }
        },
        "networkPolicy": {
          "type": "object",
          "required": ["enabled", "allowSameNamespaceIngress", "allowExternalIngress", "extraIngress", "extraEgress"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "allowSameNamespaceIngress": { "type": "boolean" },
            "allowExternalIngress": { "type": "boolean" },
            "extraIngress": { "type": "array", "items": { "type": "object" } },
            "extraEgress": { "type": "array", "items": { "type": "object" } }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" }
      }
    },
    "clickhouse": {
      "type": "object",
      "required": ["enabled", "mode"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["operator", "standalone", "external"] },
        "shardsCount": { "type": "integer", "minimum": 1 },
        "replicasCount": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    },
    "clickhouseStandalone": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/definitions/podOptions" }],
      "properties": {
        "rollout": {
          "type": "object",
          "required": ["strategy", "partition", "podManagementPolicy", "revisionHistoryLimit"],
          "additionalProperties": true,
          "properties": {
            "strategy": { "type": "string", "enum": ["RollingUpdate", "OnDelete"] },
            "partition": { "type": "integer", "minimum": 0 },
            "podManagementPolicy": { "type": "string", "enum": ["OrderedReady", "Parallel"] },
            "revisionHistoryLimit": { "type": "integer", "minimum": 0 }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "probes": { "$ref": "#/definitions/probes" },
        "networkPolicy": { "$ref": "#/definitions/networkPolicy" }
      }
    },

    "enterprise": {
      "type": "object",
      "required": ["license"],
      "additionalProperties": false,
      "properties": {
        "license": {
          "type": "object",
          "required": ["enabled", "secret"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "secret": {
              "type": "object",
              "required": ["name", "key"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "helmTests": {
      "type": "object",
      "required": ["enabled", "clickhouseConnectivity", "activeDeadlineSeconds", "backoffLimit"],
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "clickhouseConnectivity": { "type": "boolean" },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
